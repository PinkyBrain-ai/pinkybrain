# PinkyBrain — Environment variable template
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env to git (it is gitignored).

# P2P shared secret for HMAC peer authentication.
# Must be the same on all nodes in your network.
# Minimum 16 characters, use a strong random string.
# Generate one: python3 -c 'import secrets; print(secrets.token_hex(32))'
P2P_SECRET=change-me-to-your-real-secret-minimum-16-chars