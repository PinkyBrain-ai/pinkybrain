# PinkyBrain Docker Compose — Environment variables
# Copy to .env and fill in real values:  cp .env.example .env
# Never commit .env to git.

# P2P shared secret for HMAC peer authentication (min 16 chars, strong random).
# Generate one: python3 -c 'import secrets; print(secrets.token_hex(32))'
P2P_SECRET=change-me-to-your-real-secret-minimum-16-chars

# Node name shown on the mesh (optional, defaults to pinkybrain-docker)
# NODE_NAME=pinkybrain-docker